HOST=localhost
VITE_PORT=7666
API_PORT=7667

# Google Maps — required at BUILD time (Vite embeds VITE_* into the bundle)
# Create key: Google Cloud Console → APIs → Maps JavaScript API → Credentials
# Application restrictions → HTTP referrers (add ALL that you use):
#   http://localhost:7666/*
#   https://rockhoundutah.com/*
#   https://www.rockhoundutah.com/*
# Do not add a trailing = unless it is part of your actual key string.
VITE_GOOGLE_MAPS_API_KEY=your_key_here

# Server-only (never VITE_ prefix)
EMAIL_USER=
EMAIL_APP_PASSWORD=
