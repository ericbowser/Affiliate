HOST=localhost
VITE_PORT=7666
API_PORT=7667

# Google Maps — required at BUILD time (Vite embeds VITE_* into the bundle)
# Create key: Google Cloud Console → APIs → Maps JavaScript API → Credentials
# Application restrictions → HTTP referrers (add ALL that you use):
#   http://localhost:7666/*
#   https://rockhoundutah.com/*
#   https://www.rockhoundutah.com/*
# Do not add a trailing = unless it is part of your actual key string.
VITE_GOOGLE_MAPS_API_KEY=your_key_here

# Server-only (never VITE_ prefix) — Subscribe + contact forms
EMAIL_USER=ericbo@execute-engrave.com
EMAIL_RECEIVE=info@execute-engrave.com

# OAuth2 (recommended) — same Google Cloud project as Maps is fine
# 1. Enable Gmail API
# 2. OAuth consent screen → scope https://mail.google.com/
# 3. Web OAuth client → redirect http://localhost:3030/oauth2callback
# 4. npm run email:oauth → paste refresh token below
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REFRESH_TOKEN=

# Legacy fallback (if OAuth unavailable)
# EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# API server logging: debug | info | warn | error (default: debug in dev, info in prod)
# LOG_LEVEL=debug

# Optional: full API URL at build time if /api is on another host (default: same-origin /api)
# VITE_API_URL=
