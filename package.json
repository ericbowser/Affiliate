{
  "name": "toolstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI tools reviews & comparisons — affiliate marketing site",
  "scripts": {
    "dev": "vite",
    "tail": "npx tailwindcss -i ./src/styles/input.css -o ./src/styles/output.css",
    "build": "vite build",
    "clean": "rm node_modules -R && npm install",
    "preview": "vite preview",
    "tail:build": "npx tailwindcss -i ./src/styles/input.css -o ./src/styles/output.css",
    "tail:watch": "npx tailwindcss -i ./src/styles/input.css -o ./src/styles/output.css --watch",
    "server": "node server.js",
    "server:dev": "node --watch server.js",
    "sitemap": "node generateSitemap.js"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.8",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "nodemailer": "^8.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.23.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@rollup/plugin-json": "^6.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.2",
    "babel-jest": "^30.4.1",
    "dotenv": "^17.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.2"
  },
  "keywords": [
    "affiliate",
    "metal detector",
    "rock hammer",
    "GPS",
    "field gear",
    "Utah",
    "BLM",
    "rockhounding",
    "metal detecting",
    "rockhounding gear",
    "reviews"
  ],
  "author": "E.R.B. (Eric Bowser)",
  "license": "MIT"
}
