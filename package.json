{
  "name": "toolstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI tools reviews & comparisons — affiliate marketing site",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run server:dev\" \"vite\"",
    "dev:web": "vite",
    "dev:all": "npm run dev",
    "tail": "npx tailwindcss -i ./src/styles/input.css -o ./src/styles/output.css",
    "build": "vite build",
    "postbuild": "react-snap",
    "clean": "rm node_modules -R && npm install",
    "preview": "vite preview",
    "tail:build": "npx tailwindcss -i ./src/styles/input.css -o ./src/styles/output.css",
    "tail:watch": "npx tailwindcss -i ./src/styles/input.css -o ./src/styles/output.css --watch",
    "server": "node server.js",
    "email:test": "node scripts/test-smtp.js",
    "email:oauth": "node scripts/google-oauth-setup.js",
    "server:dev": "node --watch server.js",
    "dev:email": "concurrently \"npm run server:dev\" \"npm run dev\"",
    "sitemap": "node generateSitemap.js"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@react-google-maps/api": "^2.20.8",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "nodemailer": "^8.0.10",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.23.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@rollup/plugin-json": "^6.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.2",
    "babel-jest": "^30.4.1",
    "concurrently": "^9.1.2",
    "dotenv": "^17.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "pino-pretty": "^13.1.3",
    "react-snap": "^1.13.1",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.2"
  },
  "keywords": [
    "affiliate",
    "metal detector",
    "rock hammer",
    "GPS",
    "field gear",
    "Utah",
    "BLM",
    "rockhounding",
    "metal detecting",
    "rockhounding gear",
    "reviews"
  ],
  "author": "E.R.B. (Eric Bowser)",
  "license": "MIT",
  "reactSnap": {
    "source": "dist",
    "destination": "dist",
    "skipThirdPartyRequests": true,
    "headless": true,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "executablePath": "C:/Program Files/Google/Chrome/Application/chrome.exe",
    "puppeteerExecutablePath": "C:/Program Files/Google/Chrome/Application/chrome.exe",
    "inlineCss": false,
    "crawl": true
  }
}
