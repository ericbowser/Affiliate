# Snippet for rockhoundutah.com — proxy /api to the Node email server.
# Static files from dist/ are served separately (root or try_files).
#
# 1. On the Pi: copy .env with EMAIL_USER + EMAIL_APP_PASSWORD (Gmail app password, no spaces)
# 2. Run: API_PORT=7667 node server.js  (or use pm2/systemd)
# 3. Include this inside your server { } block:

location /api/ {
    proxy_pass http://127.0.0.1:7667;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
